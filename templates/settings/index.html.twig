{% extends 'app.html.twig' %}

{% block title %}Paramètres · Homely{% endblock %}

{% block content %}
<div class="room-detail">
    <a href="{{ path('app_home') }}" class="back-btn" aria-label="Retour">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5 8 12l7 7"/></svg>
    </a>

    <h1 class="settings-title display">Paramètres</h1>

    <section class="settings-section">
        <h2 class="settings-section-title">Affichage et compte</h2>
        <div class="member-list">
            <div class="member-row foyer-row">
                <span class="member-info">
                    <span class="member-name">Thème</span><br>
                    <span class="member-email">Clair ou sombre</span>
                </span>
                <button type="button" class="btn btn-ghost" id="themeToggle" aria-label="Changer de thème clair / sombre">
                    <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
                </button>
            </div>
            <div class="member-row foyer-row">
                <span class="member-info">
                    <span class="member-name">{{ app.user.pseudo }}</span><br>
                    <span class="member-email">{{ app.user.email }}</span>
                </span>
                <a href="{{ path('app_logout') }}" class="btn btn-ghost">Se déconnecter</a>
            </div>
        </div>
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">Code du foyer</h2>
        <div class="code-card">
            <div class="code-card-name">{{ foyer.name }}</div>
            <div class="code-card-row">
                <span class="code-card-value" id="inviteCodeValue">{{ foyer.inviteCode }}</span>
                <button type="button" class="btn btn-ghost" id="copyInviteCode" data-code="{{ foyer.inviteCode }}">Copier</button>
            </div>
            <p class="settings-hint">Partage ce code pour que quelqu'un rejoigne le foyer (inscription, ou page « Mes foyers » s'il a déjà un compte). <a href="{{ path('app_foyers') }}">Gérer mes foyers</a></p>
        </div>
    </section>

    <section class="settings-section">
        <div class="settings-section-head">
            <h2 class="settings-section-title">Membres du foyer</h2>
            <button type="button" class="icon-btn" data-open-modal="memberModal" aria-label="Ajouter un membre" title="Ajouter un membre">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            </button>
        </div>
        <div class="member-list">
            {% for member in members %}
                <div class="member-row">
                    <span class="member-avatar">{{ member.pseudo|slice(0, 1)|upper }}</span>
                    <span class="member-info">
                        <span class="member-name">{{ member.pseudo }}{% if member.id == app.user.id %} <span class="member-you">(toi)</span>{% endif %}{% if foyer.owner and foyer.owner.id == member.id %} <span class="member-you">· créateur</span>{% endif %}</span><br>
                        <span class="member-email">{{ member.email }}</span>
                    </span>
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">Pièces</h2>
        {% if rooms|length == 0 %}
            <p class="empty-state">Aucune pièce pour l'instant.</p>
        {% endif %}
        <div class="member-list">
            {% for room in rooms %}
                <div class="member-row foyer-row">
                    <span class="room-chip" style="--room-color: {{ room.color }}">{% include 'partials/_room_icon.html.twig' with {key: room_icon_key(room.label ~ ' ' ~ room.roomType.label)} %}</span>
                    <span class="member-info"><span class="member-name">{{ room.label }}</span></span>
                    <button type="button" class="btn btn-ghost" data-open-modal="roomColorModal"
                        data-update-url="{{ path('app_settings_room_color', {id: room.id}) }}"
                        data-room-name="{{ room.label }}"
                        data-room-color="{{ room.color }}"
                        aria-label="Changer la couleur de {{ room.label }}">Couleur</button>
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">Tâches</h2>
        {% if rooms|length == 0 %}
            <p class="empty-state">Aucune pièce pour l'instant.</p>
        {% endif %}
        {% for room in rooms %}
            {% if room.roomTasks|length > 0 %}
                <div class="settings-room-group">
                    <h3 class="settings-room-title" style="--room-color: {{ room.color }}"><span class="settings-room-dot"></span>{{ room.label }}</h3>
                    <div class="settings-task-list">
                        {% for roomTask in room.roomTasks %}
                            <div class="settings-task-row">
                                <span class="settings-task-info">
                                    <span class="settings-task-name">{{ roomTask.label }}</span><br>
                                    <span class="settings-task-meta">tous les {{ roomTask.frequencyDays }} j · dernier : {{ roomTask.lastDoneAt ? roomTask.lastDoneAt|date('d/m/Y') : 'jamais' }}</span>
                                </span>
                                <button type="button" class="icon-btn settings-task-edit" aria-label="Modifier la tâche"
                                    data-open-modal="taskEditModal"
                                    data-task-id="{{ roomTask.id }}"
                                    data-task-name="{{ roomTask.label }}"
                                    data-task-frequency="{{ roomTask.frequencyDays }}"
                                    data-task-last-done="{{ roomTask.lastDoneAt ? roomTask.lastDoneAt|date('Y-m-d') : '' }}"
                                    data-task-room="{{ room.label }}">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                </button>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </section>
</div>

<dialog id="roomColorModal" class="sheet-dialog">
    <form method="post" action="" class="sheet" id="roomColorForm">
        <div class="sheet-handle"></div>
        <h2 id="roomColorTitle">Couleur de la pièce</h2>
        {% include 'partials/_color_picker.html.twig' %}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('update_room_color') }}">
        <div class="sheet-actions">
            <button type="button" class="btn btn-ghost" data-close-modal>Annuler</button>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>
    </form>
</dialog>

<dialog id="memberModal" class="sheet-dialog">
    <form method="post" action="{{ path('app_settings_add_member') }}" class="sheet">
        <div class="sheet-handle"></div>
        <h2>Ajouter un membre</h2>
        <label>Prénom / pseudo
            <input name="pseudo" required maxlength="60" placeholder="Ex : Julien">
        </label>
        <label>Email
            <input name="email" type="email" required placeholder="julien@exemple.fr">
        </label>
        <label>Mot de passe
            <input name="password" type="password" required minlength="8" placeholder="8 caractères minimum">
        </label>
        <label>Confirmation
            <input name="password_confirm" type="password" required minlength="8">
        </label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('add_member') }}">
        <div class="sheet-actions">
            <button type="button" class="btn btn-ghost" data-close-modal>Annuler</button>
            <button type="submit" class="btn btn-primary">Ajouter</button>
        </div>
    </form>
</dialog>

{% include 'room/_task_edit_modal.html.twig' %}
{% endblock %}
