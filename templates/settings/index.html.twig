{% extends 'app.html.twig' %}

{% block title %}Paramètres · Homely{% endblock %}

{% block content %}
<div class="room-detail">
    <a href="{{ path('app_home') }}" class="back-btn" aria-label="Retour">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5 8 12l7 7"/></svg>
    </a>

    <h1 class="settings-title display">Paramètres</h1>

    <section class="settings-section">
        <h2 class="settings-section-title">Code du foyer</h2>
        <div class="code-card">
            <div class="code-card-name">{{ foyer.name }}</div>
            <div class="code-card-row">
                <span class="code-card-value" id="inviteCodeValue">{{ foyer.inviteCode }}</span>
                <button type="button" class="btn btn-ghost" id="copyInviteCode" data-code="{{ foyer.inviteCode }}">Copier</button>
            </div>
            <p class="settings-hint">Partage ce code pour que quelqu'un rejoigne le foyer depuis l'écran d'inscription.</p>
        </div>
    </section>

    <section class="settings-section">
        <div class="settings-section-head">
            <h2 class="settings-section-title">Membres du foyer</h2>
            <button type="button" class="icon-btn" data-open-modal="memberModal" aria-label="Ajouter un membre" title="Ajouter un membre">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            </button>
        </div>
        <div class="member-list">
            {% for member in members %}
                <div class="member-row">
                    <span class="member-avatar">{{ member.pseudo|slice(0, 1)|upper }}</span>
                    <span class="member-info">
                        <span class="member-name">{{ member.pseudo }}{% if member.id == app.user.id %} <span class="member-you">(toi)</span>{% endif %}</span><br>
                        <span class="member-email">{{ member.email }}</span>
                    </span>
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="settings-section">
        <h2 class="settings-section-title">Tâches</h2>
        {% if rooms|length == 0 %}
            <p class="empty-state">Aucune pièce pour l'instant.</p>
        {% endif %}
        {% for room in rooms %}
            {% if room.tasks|length > 0 %}
                <div class="settings-room-group">
                    <h3 class="settings-room-title" style="--room-color: {{ room.color }}"><span class="settings-room-dot"></span>{{ room.name }}</h3>
                    <div class="settings-task-list">
                        {% for task in room.tasks %}
                            <div class="settings-task-row">
                                <span class="settings-task-info">
                                    <span class="settings-task-name">{{ task.name }}</span><br>
                                    <span class="settings-task-meta">tous les {{ task.frequencyDays }} j · dernier : {{ task.lastDoneAt ? task.lastDoneAt|date('d/m/Y') : 'jamais' }}</span>
                                </span>
                                <button type="button" class="icon-btn settings-task-edit" aria-label="Modifier la tâche"
                                    data-open-modal="taskEditModal"
                                    data-task-id="{{ task.id }}"
                                    data-task-name="{{ task.name }}"
                                    data-task-frequency="{{ task.frequencyDays }}"
                                    data-task-last-done="{{ task.lastDoneAt ? task.lastDoneAt|date('Y-m-d') : '' }}"
                                    data-task-room="{{ room.name }}">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                </button>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </section>
</div>

<dialog id="memberModal" class="sheet-dialog">
    <form method="post" action="{{ path('app_settings_add_member') }}" class="sheet">
        <div class="sheet-handle"></div>
        <h2>Ajouter un membre</h2>
        <label>Prénom / pseudo
            <input name="pseudo" required maxlength="60" placeholder="Ex : Julien">
        </label>
        <label>Email
            <input name="email" type="email" required placeholder="julien@exemple.fr">
        </label>
        <label>Mot de passe
            <input name="password" type="password" required minlength="8" placeholder="8 caractères minimum">
        </label>
        <label>Confirmation
            <input name="password_confirm" type="password" required minlength="8">
        </label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('add_member') }}">
        <div class="sheet-actions">
            <button type="button" class="btn btn-ghost" data-close-modal>Annuler</button>
            <button type="submit" class="btn btn-primary">Ajouter</button>
        </div>
    </form>
</dialog>

<dialog id="taskEditModal" class="sheet-dialog">
    <form method="post" action="" class="sheet" id="taskEditForm">
        <div class="sheet-handle"></div>
        <h2 id="taskEditTitle">Modifier la tâche</h2>
        <label>Nom
            <input name="name" id="taskEditName" required maxlength="120">
        </label>
        <label>Fréquence (jours)
            <input name="frequencyDays" id="taskEditFrequency" type="number" min="1" required>
        </label>
        <label>Dernier nettoyage
            <input name="lastDoneAt" id="taskEditLastDone" type="date">
        </label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('update_task') }}">
        <div class="sheet-actions sheet-actions-split">
            <button type="button" class="btn btn-ghost" id="taskEditDelete">Supprimer</button>
            <span class="sheet-actions-spacer"></span>
            <button type="button" class="btn btn-ghost" data-close-modal>Annuler</button>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>
    </form>
</dialog>

<form method="post" action="" id="taskDeleteForm" hidden>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_task') }}">
</form>
{% endblock %}
