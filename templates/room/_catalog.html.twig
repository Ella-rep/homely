{% if catalogTasks|length == 0 %}
    <p class="empty-state">Plus de suggestions pour cette pièce.</p>
{% else %}
    <div class="catalog-group">
        <h3 class="catalog-group-title">{{ room.roomType.label }}</h3>
        <div class="catalog-list">
            {% for item in catalogTasks %}
                <label class="catalog-item">
                    <input type="checkbox" name="tasks[]" value="{{ item.id }}">
                    <span class="catalog-item-name">{{ item.label }}</span>
                    <span class="catalog-item-freq">tous les {{ item.defaultFrequencyDays }} j</span>
                </label>
            {% endfor %}
        </div>
    </div>
{% endif %}
