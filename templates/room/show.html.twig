{% extends 'app.html.twig' %}

{% block title %}{{ room.label }} · Homely{% endblock %}

{% block page_id %}room{% endblock %}

{% block content %}
<div class="room-detail">
    <a href="{{ path('app_home') }}" class="back-btn" aria-label="Retour">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg>
    </a>

    <div class="room-hero" style="--room-color: {{ room.color }}">
        <div class="hero-top">
            <div class="hero-id">
                <span class="room-chip room-chip-lg">{% include 'partials/_room_icon.html.twig' with {key: room_icon_key(room.label ~ ' ' ~ room.roomType.label)} %}</span>
                <div>
                    <h1 class="hero-name display">{{ room.label }}</h1>
                    <div class="hero-meta">{{ room.taskCount }} tâche{{ room.taskCount > 1 ? 's' : '' }}{% if room.taskCount > 0 %} · {{ room.cleanCount }} à jour{% endif %}</div>
                </div>
            </div>
            {% if room.taskCount > 0 %}
                <svg class="hero-ring" viewBox="0 0 64 64" width="74" height="74" role="img" aria-label="{{ room.cleanPercent }} % des tâches à jour">
                    <circle class="ring-track" cx="32" cy="32" r="26" fill="none" stroke-width="7"/>
                    <circle class="ring-fill" cx="32" cy="32" r="26" fill="none" stroke-width="7" stroke-linecap="round" pathLength="100" stroke-dasharray="{{ room.cleanPercent }} 100" transform="rotate(-90 32 32)"/>
                    <text x="32" y="37" text-anchor="middle">{{ room.cleanPercent }}%</text>
                </svg>
            {% endif %}
        </div>
        {% if room.overdueCount > 0 or room.dueSoonCount > 0 %}
            <div class="hero-badges">
                {% if room.overdueCount > 0 %}<span class="status-badge overdue">{{ room.overdueCount }} en retard</span>{% endif %}
                {% if room.dueSoonCount > 0 %}<span class="status-badge due_soon">{{ room.dueSoonCount }} bientôt</span>{% endif %}
            </div>
        {% endif %}
    </div>

    {% if room.roomTasks|length == 0 %}
        <p class="empty-state">Aucune tâche dans cette pièce.<br>Appuie sur + pour en ajouter une.</p>
    {% else %}
        {% set groups = [
            {key: 'overdue', title: 'En retard'},
            {key: 'due_soon', title: 'À faire bientôt'},
            {key: 'clean', title: 'À jour'},
        ] %}
        {% for group in groups %}
            {% set items = groupedTasks[group.key] %}
            {% if items|length > 0 %}
                <section class="task-group" aria-labelledby="group-{{ group.key }}">
                    <h2 class="task-group-title" id="group-{{ group.key }}"><span class="status-badge {{ group.key }}">{{ group.title }} · {{ items|length }}</span></h2>
                    <div class="task-list">
                        {% for roomTask in items %}
                            {% include 'room/_task_card.html.twig' %}
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        {% endfor %}
    {% endif %}

    <button type="button" class="btn btn-ghost btn-block catalog-open-btn" data-open-modal="catalogModal">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2V5Z"/><path d="M4 19a2 2 0 0 1 2-2h13"/></svg>
        Choisir depuis le catalogue
    </button>
</div>
{% endblock %}

{% block fab %}
<button type="button" class="fab" data-open-modal="taskModal" aria-label="Ajouter une tâche">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
</button>

<dialog id="taskModal" class="sheet-dialog">
    <form method="post" action="{{ path('app_task_create', {id: room.id}) }}" class="sheet">
        <div class="sheet-handle"></div>
        <h2>Nouvelle tâche</h2>
        <label>Nom
            <input name="name" required maxlength="120" placeholder="Ex : Passer l'aspirateur" autofocus>
        </label>
        <label>Fréquence (jours)
            <input name="frequencyDays" type="number" min="1" value="7" required>
        </label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('add_task') }}">
        <div class="sheet-actions">
            <button type="button" class="btn btn-ghost" data-close-modal>Annuler</button>
            <button type="submit" class="btn btn-primary">Créer</button>
        </div>
    </form>
</dialog>

<dialog id="catalogModal" class="sheet-dialog">
    <form method="post" action="{{ path('app_task_create_from_catalog', {id: room.id}) }}" class="sheet sheet-tall">
        <div class="sheet-handle"></div>
        <h2>Catalogue de tâches</h2>
        <div class="catalog-scroll">
            {% include 'room/_catalog.html.twig' %}
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('add_task_catalog') }}">
        <div class="sheet-actions">
            <button type="button" class="btn btn-ghost" data-close-modal>Annuler</button>
            <button type="submit" class="btn btn-primary">Ajouter la sélection</button>
        </div>
    </form>
</dialog>
{% include 'room/_task_edit_modal.html.twig' %}
{% endblock %}
