{% extends 'app.html.twig' %}

{% block title %}{{ room.name }} · Homely{% endblock %}

{% block content %}
<div class="room-detail">
    <a href="{{ path('app_home') }}" class="back-btn" aria-label="Retour">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5 8 12l7 7"/></svg>
    </a>

    <div class="room-hero" style="--room-color: {{ room.color }}">
        <span class="tile-icon">{% include 'partials/_room_icon.html.twig' with {key: room_icon_key(room.name)} %}</span>
        <div class="hero-name display">{{ room.name }}</div>
        <div class="hero-meta">{{ room.tasks|length }} tâche{{ room.tasks|length > 1 ? 's' : '' }}</div>
    </div>

    {% if room.tasks|length == 0 %}
        <p class="empty-state">Aucune tâche dans cette pièce.<br>Appuie sur + pour en ajouter une.</p>
    {% else %}
        <div class="task-list">
            {% for task in room.tasks %}
                <div class="task-card">
                    <div class="task-top">
                        <span class="task-name">{{ task.name }}</span>
                        <span class="due-pill {{ task.status }}">{{ task.dueLabel }}</span>
                    </div>
                    <div class="progress-track">
                        <div class="progress-fill {{ task.status }}" style="width: {{ task.progressPercent }}%"></div>
                    </div>
                    <form method="post" action="{{ path('app_task_complete', {id: task.id}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('complete_task') }}">
                        <button type="submit" class="btn-done">
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9.5 18 20 6"/></svg>
                            C'est fait
                        </button>
                    </form>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <button type="button" class="btn btn-ghost btn-block catalog-open-btn" data-open-modal="catalogModal">
        📖 Choisir depuis le catalogue
    </button>
</div>
{% endblock %}

{% block fab %}
<button type="button" class="fab" data-open-modal="taskModal" aria-label="Ajouter une tâche">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
</button>

<dialog id="taskModal" class="sheet-dialog">
    <form method="post" action="{{ path('app_task_create', {id: room.id}) }}" class="sheet">
        <div class="sheet-handle"></div>
        <h2>Nouvelle tâche</h2>
        <label>Nom
            <input name="name" required maxlength="120" placeholder="Ex : Passer l'aspirateur">
        </label>
        <label>Fréquence (jours)
            <input name="frequencyDays" type="number" min="1" value="7" required>
        </label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('add_task') }}">
        <div class="sheet-actions">
            <button type="button" class="btn btn-ghost" data-close-modal>Annuler</button>
            <button type="submit" class="btn btn-primary">Créer</button>
        </div>
    </form>
</dialog>

<dialog id="catalogModal" class="sheet-dialog">
    <form method="post" action="{{ path('app_task_create_from_catalog', {id: room.id}) }}" class="sheet sheet-tall">
        <div class="sheet-handle"></div>
        <h2>Catalogue de tâches</h2>
        <div class="catalog-scroll">
            {% include 'room/_catalog.html.twig' %}
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('add_task_catalog') }}">
        <div class="sheet-actions">
            <button type="button" class="btn btn-ghost" data-close-modal>Annuler</button>
            <button type="submit" class="btn btn-primary">Ajouter la sélection</button>
        </div>
    </form>
</dialog>
{% endblock %}
